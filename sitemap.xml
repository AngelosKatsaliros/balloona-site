---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign langs = "el,en,de" | split: "," -%}
{%- for entry in site.data.pages %}
{%- assign p = entry[1] %}
{%- for l in langs %}
  <url>
    <loc>{{ site.canonical_url }}{{ p[l] }}</loc>
{%- for a in langs %}
    <xhtml:link rel="alternate" hreflang="{{ a }}" href="{{ site.canonical_url }}{{ p[a] }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.canonical_url }}{{ p.el }}"/>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
